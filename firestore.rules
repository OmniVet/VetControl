rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Troque pelo SEU e-mail (o mesmo do firebase-config.js)
    function masterEmail() { return "vetplusespecialidades@gmail.com"; }

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function ativo() { return temPerfil() && perfil().ativo == true; }
    function master() { return ativo() && perfil().role == "master"; }
    function gerente() { return ativo() && perfil().cargo == "gerente"; }
    function estoquista() { return ativo() && perfil().role in ["master", "estoquista"]; }

    match /users/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      // primeiro acesso do master cria o próprio perfil; demais só o master cria
      allow create: if master() ||
        (logado() && request.auth.uid == uid && request.auth.token.email == masterEmail()
         && request.resource.data.role == "master");
      allow update, delete: if master();
    }

    // Quantidades do estoque só mudam pela estoquista/master (equipe lança pendências)
    match /produtos/{id} {
      allow read: if ativo();
      allow create: if ativo();
      allow update: if estoquista() || (ativo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lotesEstoque','lotesLimbo']));
      allow delete: if master();
    }

    match /salas/{sala}/itens/{id} {
      allow read, write: if ativo();
    }

    // Histórico não pode ser alterado nem apagado (auditoria)
    match /movimentos/{id} {
      allow read, create: if ativo();
      allow update, delete: if false;
    }

    match /pedidos/{id} {
      allow read, create: if ativo();
      allow update, delete: if master();
    }

    match /solicitacoes/{id} {
      allow read, create, update: if ativo();
      allow delete: if master() || (ativo() && resource.data.solicitanteUid == request.auth.uid && resource.data.status == "Pendente");
    }

    match /exames/{id} {
      allow read, create, update: if ativo();
      allow delete: if master();
    }

    match /inventario/{id} {
      allow read, create, update: if ativo();
      allow delete: if master();
    }

    match /notas/{id} {
      allow read, create: if ativo();
      allow update, delete: if master();
    }

    match /profissionais/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    match /catalogoExames/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    // Valor pago ao laboratório (comparar com a cobrança do laboratório): só o master
    match /catalogoCustos/{id} {
      allow read, write: if master();
    }

    match /pendencias/{id} {
      allow read, create: if ativo();
      allow update: if estoquista();
      allow delete: if master();
    }

    match /contagens/{id} {
      allow read, create: if ativo();
      allow update, delete: if master();
    }

    match /modelosLaudo/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    // Laudos liberados não podem ser alterados (só o master corrige)
    match /laudos/{id} {
      allow read, create: if ativo();
      // só quem liberou o laudo pode editá-lo; só o master apaga
      allow update: if ativo() && resource.data.liberadoUid == request.auth.uid;
      allow delete: if master();
    }

    match /servicos/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    match /pacotes/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    match /orcamentos/{id} {
      allow read, create: if ativo();
      allow update, delete: if master();
    }

    // ===== Vacinas / portal do tutor =====
    // O tutor (login por CPF) só lê os próprios dados. Ele não tem documento em /users, então ativo() é falso para ele.
    match /tutores/{cpf} {
      allow read: if ativo() || (logado() && resource.data.uid == request.auth.uid);
      allow write: if ativo();
    }
    match /pets/{id} {
      allow read: if ativo() || (logado() && resource.data.tutorUid == request.auth.uid);
      allow write: if ativo();
    }
    match /vacinacoes/{id} {
      allow read: if ativo() || (logado() && resource.data.tutorUid == request.auth.uid);
      allow create, update: if ativo();
      allow delete: if master();
    }
    // Só a versão do login, indexada pelo hash do CPF: dá para consultar um, nunca listar
    match /acessos/{hash} {
      allow get: if true;
      allow list: if false;
      allow write: if ativo();
    }
    match /avisosVacina/{id} {
      allow read, create: if ativo();
    }
    match /config/{id} {
      allow read, write: if ativo();
    }
    match /conferenciasInventario/{id} {
      allow read, create: if ativo();
    }
    match /equivalencias/{id} {
      allow read: if ativo();
      allow write: if estoquista();
    }
    match /listaCompras/{id} {
      allow read, write: if ativo();
    }
    match /programados/{id} {
      allow read, write: if ativo();
    }

    match /cotacoes/{id} {
      allow read, create, update: if ativo();
      allow delete: if master();
    }

    match /fornecedores/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    // ===== NOSSO TIME =====
    match /timeAtividades/{id} {
      allow read: if ativo();
      allow write: if master();
    }
    match /timeConclusoes/{id} {
      allow read: if ativo();
      allow create: if ativo() && (master() || request.resource.data.pessoaId == request.auth.uid);
      allow delete: if ativo() && (master() || resource.data.pessoaId == request.auth.uid);
      allow update: if false;
    }
    // Avaliações: SÓ o master lê e escreve
    // Avaliações: Master e Gerente veem e editam; a pessoa avaliada só lê a própria
    match /timeAvaliacoes/{id} {
      allow read: if master() || gerente() || (ativo() && resource.data.pessoaId == request.auth.uid);
      allow write: if master() || gerente();
    }
    // Confirmação/assinatura: o master cria; a própria pessoa só assina (uma vez); ninguém apaga
    match /timeAssinaturas/{id} {
      allow read: if master() || gerente() || (ativo() && resource.data.pessoaId == request.auth.uid);
      allow create: if master() || gerente();
      allow update: if ativo() && resource.data.pessoaId == request.auth.uid && resource.data.status == "Aguardando"
        && request.resource.data.status == "Assinado" && request.resource.data.assinadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "assinadoEm", "hash"]);
      allow delete: if false;
    }
    // Ponto: só criar (horário do servidor). Sem alterar nem apagar, para ninguém, nem o master.
    match /timePonto/{id} {
      allow read: if ativo() && (master() || resource.data.uid == request.auth.uid);
      allow create: if ativo() && perfil().cargo in ["auxiliar", "gerente", "recepcao", "assistente"] && request.resource.data.uid == request.auth.uid && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
    match /timeCorrecoes/{id} {
      allow read: if ativo() && (master() || resource.data.uid == request.auth.uid);
      allow create: if ativo() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "Pendente";
      allow update: if master();
      allow delete: if false;
    }
    // Documentação e treinamentos do time: só Master e Gerente
    match /timeDocModelos/{id} { allow read, write: if master() || gerente(); }
    match /timeDocAssin/{id} { allow read, write: if master() || gerente(); }
    match /timeTreinos/{id} { allow read, write: if master() || gerente(); }
    match /timeConfig/{id} {
      allow read: if ativo();
      allow write: if master();
    }

    // Entrevistas de candidatos (dados pessoais): só master e gerente
    // Repasse ou venda (empréstimo/venda de produtos do estoque)
    match /repasses/{id} {
      allow read, create, update: if ativo();
      allow delete: if master();
    }
    match /entrevistas/{id} {
      allow read, write: if master() || gerente();
    }
  }
}
